
# Django configuration
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL configuration
DB_NAME=your_branch_database_name
DB_USER=your_mysql_username
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Local development: leave HTTPS-only settings disabled.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Set these to true only when your trusted deployment proxy
# is correctly configured.
USE_X_FORWARDED_HOST=False
TRUST_PROXY_SSL_HEADER=False
